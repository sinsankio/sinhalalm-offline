flowchart LR
  subgraph Page["Page (UI thread)"]
    UI["Question box,<br/>streamed answer"]
  end
  subgraph Worker["Web Worker"]
    TK["transformers.js tokenizer"]
    GEN["transformers.js generation<br/>key-value cache"]
  end
  subgraph ORT["ONNX Runtime Web"]
